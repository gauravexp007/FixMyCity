PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civictrack
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional Cloudinary (falls back to local uploads if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Admin bootstrap (used by seed script)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@civictrack.gov
ADMIN_PASSWORD=Admin@123456

# --- Database backend -------------------------------------------------------
# Firestore is used automatically when Firebase Admin credentials are present.
# Leave empty for auto-detection, or force with: firestore | mongodb
DB_BACKEND=
FIREBASE_PROJECT_ID=fixmycity-51576
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the JSON here (or a path to it, or base64 of it). Never commit the real key.
FIREBASE_SERVICE_ACCOUNT=
# Seed demo accounts + [Sample] complaints into an empty database.
SEED_DEMO_DATA=true
# Local development only: run `firebase emulators:start --only firestore`
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
