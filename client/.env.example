# Optional: point the client at a separately hosted API (e.g. Render).
# Leave unset to use the Vite dev proxy at /api.
VITE_API_URL=

# Firebase project (FixMyCity). Leave unset to use the values in src/services/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
